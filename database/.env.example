# ============================================================
# apreu-db (PostgreSQL 16) · variables del contenedor
# Solo se aplican la primera vez (volumen de datos vacío).
# ============================================================
POSTGRES_USER=postgres
# Obligatoria. Use una clave larga (p. ej. openssl rand -hex 24)
POSTGRES_PASSWORD=
# BD maestra (tenants + operadores superadmin); debe coincidir con MASTER_DB_NAME de las APIs
MASTER_DB_NAME=apreu_master

# Las APIs se conectan a este servidor con:
#   apreu-api      → TENANT_DB_HOST / TENANT_DB_USER / TENANT_DB_PASSWORD (+ MASTER_DB_*)
#   superadmin-api → MASTER_DB_* y TENANT_DB_ADMIN_* (rol con CREATEDB para crear apreu_<slug>)
# Recomendado en producción: crear roles separados en lugar de usar POSTGRES_USER.
