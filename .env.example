# ============================================================
# superadmin-api · variables de entorno (copie a .env y complete)
# Nunca suba el archivo .env con valores reales.
# ============================================================
NODE_ENV=development
PORT=3100
# Orígenes permitidos (coma separada): la consola superadmin-web
CORS_ORIGINS=http://localhost:4200
# Proxies inversos delante de la API (Express "trust proxy"): número de saltos o IP/subredes.
# 1 = detrás del nginx de superadmin-web (Docker). Vacío = API expuesta directamente (no confiar en X-Forwarded-For).
TRUST_PROXY=

# --- JWT de plataforma (DISTINTO del JWT_SECRET de apreu-api; >= 32 caracteres en producción)
SUPERADMIN_JWT_SECRET=
SUPERADMIN_JWT_EXPIRES_IN=2h

# --- Límite de intentos de login (por IP)
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_SECONDS=60

# --- BD maestra PostgreSQL (tabla tenants + users con rol superadmin; conexión en UTC)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_USER=
MASTER_DB_PASSWORD=
MASTER_DB_NAME=apreu_master

# --- Servidor PostgreSQL de los colegios (una BD apreu_<slug> por colegio)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_PREFIX=apreu_
TENANT_DB_CONNECT_TIMEOUT_MS=5000
# BD a la que se conecta la cuenta de aprovisionamiento para CREATE/DROP DATABASE
TENANT_DB_MAINTENANCE_DB=postgres
# Cuenta de aprovisionamiento: rol con CREATEDB (no superusuario)
TENANT_DB_ADMIN_USER=
TENANT_DB_ADMIN_PASSWORD=
# Rol propietario de cada BD de colegio y de sus objetos (la cuenta TENANT_DB_USER de apreu-api).
# La cuenta de aprovisionamiento debe ser miembro de este rol. Vacío = propietario la cuenta de aprovisionamiento.
TENANT_DB_OWNER=
# Cuenta de solo lectura para la analítica (recibe CONNECT + SELECT en cada colegio nuevo; si se omite, usa la de aprovisionamiento)
TENANT_DB_READER_USER=
TENANT_DB_READER_PASSWORD=

# --- Aprovisionamiento (rutas relativas al directorio de ejecución)
# En Docker NO las defina: la imagen ya trae los scripts en /app/database/postgres y fija estas rutas.
TENANT_SCHEMA_FILE=database/postgres/tenant-schema.sql
# Migraciones NNN-*.sql idempotentes aplicadas tras el esquema, en orden por prefijo numérico
# y registradas en schema_migrations de cada colegio ("none" = no aplicar migraciones)
TENANT_MIGRATIONS_DIR=database/postgres/migrations
# URL pública de cada colegio ({slug} se reemplaza)
TENANT_PUBLIC_URL_TEMPLATE=https://apreu.co/{slug}

# --- Analítica cross-tenant
ANALYTICS_CONCURRENCY=4
ANALYTICS_QUERY_TIMEOUT_MS=8000
APP_TIME_ZONE=America/Bogota

# --- API interna de apreu-api (invalidación de la caché del colegio tras suspender/reactivar/editar/eliminar)
# Vacías = deshabilitado (apreu-api aplica el cambio de estado en máx. TENANT_STATUS_TTL_SECONDS).
# Ej.: http://apreu-api:3000 (misma red Docker) o https://api.apreu.co
APREU_API_URL=
# Igual al INTERNAL_API_TOKEN de apreu-api
APREU_INTERNAL_API_TOKEN=
APREU_API_TIMEOUT_MS=3000
